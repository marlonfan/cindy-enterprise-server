LISTEN_ADDR=:8080
PUBLIC_BASE_URL=https://cindy.marlon.life
# Enterprise clients use the isolated dev app identity, which maps to the CN auth realm.
CINDY_REGION=cn
DATA_DIR=/var/lib/cindy

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=cindy-enterprise
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
MEDIA_URL_TTL=15m

# Enterprise OIDC. Register OIDC_REDIRECT_URL at your IdP.
OIDC_ISSUER_URL=https://login.example.com/realms/company
OIDC_CLIENT_ID=cindy-desktop
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=https://cindy.marlon.life/api/auth/oidc/callback
OIDC_ORG_ID=company
OIDC_ORG_NAME=Example Company
OIDC_ORG_DOMAIN=example.com
OIDC_CONNECTION_NAME=Company SSO

# Local integration only. Leave empty in production.
DEV_LOGIN_CODE=

# Option A: return an existing enterprise gateway endpoint/key directly.
# MODEL_GATEWAY_ENDPOINT=https://gateway.example.com
# MODEL_GATEWAY_CLIENT_KEY=replace-me

# Option B: proxy the gateway through this single service/domain.
MODEL_GATEWAY_UPSTREAM=https://gateway.example.com
MODEL_GATEWAY_UPSTREAM_KEY=replace-with-upstream-key
MODEL_GATEWAY_CLIENT_KEY=replace-with-key-issued-to-cindy-clients

# Authoritative Cindy AI model projection: {"models":[...]}.
MODEL_LIST_FILE=/etc/cindy/model-list.json
# Optional provider catalog override. Leave empty to let the client use its bundled catalog.
MODEL_CATALOG_FILE=
